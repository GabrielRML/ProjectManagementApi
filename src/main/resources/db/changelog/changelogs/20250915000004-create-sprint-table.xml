<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="20250915000004-1" author="gabriel_lima">
        <createTable tableName="sprint">
            <column name="id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="initial_date" type="timestamp"/>
            <column name="end_date" type="timestamp"/>
            <column name="sequence" type="int4">
                <constraints nullable="false"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="sprint"
                                 baseColumnNames="project_id"
                                 referencedTableName="project"
                                 referencedColumnNames="id"
                                 constraintName="fk_sprint_project"/>
    </changeSet>
</databaseChangeLog>
